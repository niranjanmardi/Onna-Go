# ONNA-GO — Environment Configuration
PROJECT_NAME="ONNA-GO"
TAGLINE="Ride Together. Vibe Together. Split Together."
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# Generate a secure 32+ character string in production
SECRET_KEY="onnago-production-secret-key-change-this-now-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME="onnago_session"
SECURE_COOKIE=false
SAME_SITE="lax"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./splitmate.db"
# Managed PostgreSQL production example:
# DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/onnago"

# CORS Allowed Origins
# BACKEND_CORS_ORIGINS='["http://localhost:5173", "capacitor://localhost", "https://yourdomain.com"]'

# File Uploads
MAX_UPLOAD_SIZE_BYTES=5242880
